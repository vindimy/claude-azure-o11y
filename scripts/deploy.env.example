# Parameter file for scripts/deploy.sh. Same names/meanings as terraform/module-azure-o11y/variables.tf.
RESOURCE_GROUP_NAME=rg-o11y-test          # existing
LOCATION=centralus
UAMI_NAME=id-o11y-alerting                # existing; created by the IAM repo
STORAGE_ACCOUNT_NAME=sto11yalerting       # existing; containers reports/suppression are created if missing
KEY_VAULT_NAME=kv-o11y-alerting           # existing
MANAGEMENT_GROUP_ID=mg-prod               # scope of iteration; also selects config/thresholds/<id>.yaml
SUBSCRIPTION_IDS=                         # optional comma list; when set, overrides MG scope (fallback mode)
LAW_RESOURCE_ID=                          # central LAW for VM guest metrics (unused by the MVP; keep empty or set)
ACR_NAME=acrusbcloud                      # existing; UAMI needs AcrPull
IMAGE_NAME=o11y-alerting
IMAGE_TAG=                                # REQUIRED: immutable commit SHA tag built by CI (or build-image.sh)
FUNCTION_APP_NAME=func-o11y-alerting      # naming standard TBD
APP_SERVICE_PLAN_NAME=asp-o11y-alerting   # naming standard TBD
PLAN_SKU=EP1                              # Elastic Premium; Consumption is not valid for custom containers
SCHEDULE_CRON=0 */15 * * * *              # NCRONTAB
DRY_RUN=false
OPS_WEBHOOK_SECRET_NAME=o11y-ops-teams-webhook   # Key Vault secret holding the Power Automate webhook URL
APP_INSIGHTS_NAME=                        # optional existing App Insights in the same RG
