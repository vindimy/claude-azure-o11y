# Parameter file for scripts/vm-install.sh (Path C: RHEL 9 VM). Names and meanings match deploy.env.example;
# Function-App-only parameters are left out (docs/agents/deployment.md), and a full deploy.env works too.
RESOURCE_GROUP_NAME=rg-o11y-test          # existing; holds the findings DCE/DCR
UAMI_RESOURCE_ID=                         # REQUIRED: existing UAMI resource ID, created by the IAM repo and attached to the VM
MANAGEMENT_GROUP_ID=mg-prod               # scope of iteration; also selects config/thresholds/<id>.yaml
SUBSCRIPTION_IDS=                         # optional comma list; when set, overrides MG scope (fallback mode)
LAW_RESOURCE_ID=                          # REQUIRED: existing LAW; findings tables are created in it
OPS_SCHEDULE_CRON=0 */15 * * * *          # NCRONTAB (UTC); converted to a systemd timer
FINOPS_SCHEDULE_CRON=0 0 6 * * *          # NCRONTAB (UTC); daily FinOps run
DRY_RUN=false                             # true: findings go to /var/lib/o11y-alerting/out/findings/*.jsonl
APP_INSIGHTS_NAME=                        # optional existing App Insights in the same RG
VM_HOST=                                  # REQUIRED unless --inventory: VM IP or DNS name reachable over SSH
VM_SSH_USER=azureuser                     # sudo-capable admin user
RELEASE_REF=                              # commit/tag/branch to install; empty = HEAD
PIP_INDEX_URL=                            # approved PyPI mirror; empty = pip's default index
