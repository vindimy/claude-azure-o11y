# Same keys and meanings as scripts/deploy.env.example. Copy to terraform.tfvars (git-ignored).
resource_group_name     = "rg-o11y-test"
location                = "centralus"
uami_name               = "id-o11y-alerting"
storage_account_name    = "sto11yalerting"
key_vault_name          = "kv-o11y-alerting"
management_group_id     = "mg-prod"
subscription_ids        = ""
law_resource_id         = ""
acr_name                = "acrusbcloud"
image_name              = "o11y-alerting"
image_tag               = "REPLACE_WITH_CI_COMMIT_SHA"
function_app_name       = "func-o11y-alerting"
app_service_plan_name   = "asp-o11y-alerting"
plan_sku                = "EP1"
schedule_cron           = "0 */15 * * * *"
dry_run                 = false
ops_webhook_secret_name = "o11y-ops-teams-webhook"
app_insights_name       = ""
