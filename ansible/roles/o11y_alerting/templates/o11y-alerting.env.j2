# {{ ansible_managed }}
# Same settings the Function App gets from scripts/deploy.sh / the Terraform module.
AZURE_CLIENT_ID="{{ uami_client_id }}"
MG_ID="{{ management_group_id }}"
SUBSCRIPTION_IDS="{{ subscription_ids }}"
LAW_RESOURCE_ID="{{ law_resource_id }}"
DRY_RUN="{{ dry_run | bool | lower }}"
LOGS_INGESTION_ENDPOINT="{{ logs_ingestion_endpoint }}"
FINDINGS_DCR_IMMUTABLE_ID="{{ findings_dcr_immutable_id }}"
APPLICATIONINSIGHTS_CONNECTION_STRING="{{ applicationinsights_connection_string }}"
# Informational on the VM; the timers carry the converted schedules.
OPS_SCHEDULE_CRON="{{ ops_schedule_cron }}"
FINOPS_SCHEDULE_CRON="{{ finops_schedule_cron }}"
CONFIG_DIR=config
IDENTITY_FILE=identity/role-requirements.yaml
OUTPUT_DIR=/var/lib/o11y-alerting/out
O11Y_RELEASE="{{ release_ref }}"
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
