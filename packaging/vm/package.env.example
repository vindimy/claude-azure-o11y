# Parameter file for install.sh, the self-contained RHEL 9 package (docs/ops/azure-vm.md). Names match
# vm.env / deploy.env where they overlap. On a workstation with az, `scripts/vm-package-env.sh
# --param-file vm.env > package.env` writes this file; the resolved values can also be looked up by hand.
# Keep the file 0600: the App Insights connection string is in it.
MANAGEMENT_GROUP_ID=mg-prod               # scope of iteration; also selects config/thresholds/<id>.yaml
SUBSCRIPTION_IDS=                         # optional comma list; when set, overrides MG scope (fallback mode)
LAW_RESOURCE_ID=                          # REQUIRED: existing LAW that holds the findings tables
OPS_SCHEDULE_CRON=0 */15 * * * *          # NCRONTAB (UTC); converted to a systemd timer
FINOPS_SCHEDULE_CRON=0 0 6 * * *          # NCRONTAB (UTC); daily FinOps run
DRY_RUN=false                             # true: findings go to /var/lib/o11y-alerting/out/findings/*.jsonl
PIP_INDEX_URL=                            # approved PyPI mirror for both ansible-core and the app; empty = pip's default
UAMI_RESOURCE_ID=                         # REQUIRED unless UAMI_CLIENT_ID: the attached UAMI; resolved to its client ID through IMDS
UAMI_CLIENT_ID=                           # optional; skips the IMDS lookup
LOGS_INGESTION_ENDPOINT=                  # REQUIRED unless DRY_RUN=true: findings DCE logs-ingestion endpoint
FINDINGS_DCR_IMMUTABLE_ID=                # REQUIRED unless DRY_RUN=true: findings DCR immutable id
APPLICATIONINSIGHTS_CONNECTION_STRING=    # optional; enables the OpenTelemetry log export
